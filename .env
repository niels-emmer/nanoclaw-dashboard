# Docker Compose defaults
BACKEND_PORT=8000
FRONTEND_PORT=4173

# Optional: override WebSocket endpoint baked into the frontend at build time
# Leave blank to rely on the nginx proxy + same-origin path.
VITE_BACKEND_WS_URL=

# Backend settings (mirrors backend/.env.example)
NANOCLAW_APP_NAME=Nanoclaw Dashboard Backend
NANOCLAW_TRANSPORT=websocket
NANOCLAW_BASE_INTERVAL_MS=900
NANOCLAW_JITTER_MS=350
NANOCLAW_MAX_CLIENTS=50
NANOCLAW_MOCK_AGENT_NAMES=seer,navigator,scribe,smith,warden

# Nanoclaw host integration
NANOCLAW_ENABLED=false
NANOCLAW_ROOT=../nanoclaw
NANOCLAW_POLL_INTERVAL_MS=750
NANOCLAW_HISTORY_EVENTS=20
NANOCLAW_ORCHESTRATOR_GROUP=

# Host/container bind for docker compose
NANOCLAW_HOST_DATA=../nanoclaw
NANOCLAW_CONTAINER_DATA=/nanoclaw
