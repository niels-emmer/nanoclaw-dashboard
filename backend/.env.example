# Backend configuration
# Copy to backend/.env and adjust per environment.

NANOCLAW_APP_NAME=Nanoclaw Dashboard Backend
NANOCLAW_TRANSPORT=websocket
NANOCLAW_BASE_INTERVAL_MS=900
NANOCLAW_JITTER_MS=350
NANOCLAW_MAX_CLIENTS=50
NANOCLAW_MOCK_AGENT_NAMES=researcher,coder,architect,editor,terminal,plotter

# Nanoclaw host integration
NANOCLAW_ENABLED=false
NANOCLAW_ROOT=../nanoclaw
NANOCLAW_POLL_INTERVAL_MS=750
NANOCLAW_HISTORY_EVENTS=20
NANOCLAW_ORCHESTRATOR_GROUP=

# Backup / restore — writable folder for backup archives + restore scripts.
# The nanoclaw data mount is read-only by design; backups live here instead.
# In Docker this is mounted at /backups (see docker-compose.yml).
NANOCLAW_BACKUP_DIR=../backups
# Optional shared secret for /api/backup/* (sent as X-Backup-Token header).
# Set this on shared networks; the frontend mirrors it via VITE_BACKUP_TOKEN.
NANOCLAW_BACKUP_TOKEN=

